# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/app_foot"

# Supabase (auth + base de données)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Claude API (Anthropic) — génération de programme
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_ANNUAL="price_..."

# Resend (emails transactionnels)
RESEND_API_KEY="re_..."
EMAIL_FROM="[APP] <no-reply@example.com>"

# Dashboard admin (/admin) — secret partagé, pas d'auth complexe
ADMIN_DASHBOARD_SECRET="change-me"

# Vercel Cron — vérifie l'origine des appels /api/cron/*
CRON_SECRET="change-me"

# URL publique de l'app (emails, redirections Stripe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
