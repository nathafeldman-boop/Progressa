# Base de données
# DATABASE_URL: utilisée par l'app en runtime — peut pointer sur un pooler
# (ex: Supabase Supavisor en mode transaction, port 6543) pour bien gérer les
# pics de connexions serverless.
# DIRECT_URL: utilisée uniquement par les commandes Prisma (migrate, etc.),
# qui ont besoin de verrous de session — un pooler en mode transaction ne les
# supporte pas et fait planter/bloquer indéfiniment `prisma migrate deploy`.
# Doit pointer sur une connexion directe ou un pooler en mode session (port
# 5432). En local, les deux peuvent être identiques.
DATABASE_URL="postgresql://user:password@localhost:5432/app_foot"
DIRECT_URL="postgresql://user:password@localhost:5432/app_foot"

# Supabase (auth + base de données)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Mistral API — génération de programme (lib/ai/generate-program.ts) ET
# discussion libre avec Coach Brian (app/api/coach/chat). Sans cette clé, la
# génération de programme bascule sur un template déterministe et la
# discussion libre répond avec un message de repli honnête (les questions
# rapides, calculées sans LLM, restent utilisables).
MISTRAL_API_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_ANNUAL="price_..."

# Resend (emails transactionnels)
RESEND_API_KEY="re_..."
EMAIL_FROM="Progressa <no-reply@example.com>"

# Dashboard admin (/admin) — secret partagé, pas d'auth complexe
ADMIN_DASHBOARD_SECRET="change-me"

# Vercel Cron — vérifie l'origine des appels /api/cron/*
CRON_SECRET="change-me"

# URL publique de l'app (emails, redirections Stripe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
